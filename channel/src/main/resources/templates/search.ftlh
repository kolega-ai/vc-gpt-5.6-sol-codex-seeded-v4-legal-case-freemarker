<#import "layout.ftlh" as ui>
<@ui.page title="Search" active="search">
<div class="page-head"><div><div class="eyebrow">Scoped discovery</div><h1>Search the casebook</h1><p class="lede">Find matters, documents, tasks, and clients within your current authorization scope.</p></div></div>
<form class="card filterbar" method="get"><div class="field grow"><label for="q">Search terms</label><input class="input" id="q" name="q" value="${query!}" maxlength="100" placeholder="Reference, title, document, task, or client" autofocus></div><button class="btn btn-primary">Search</button></form>
<form class="card filterbar" method="post" action="/register"><@ui.csrf/><div class="field grow"><label for="court">Court register filter</label><input class="input" id="court" name="court" placeholder="CHANCERY" required><span class="hint">Remembers your preferred court for the <a href="/register">court register</a>.</span></div><button class="btn btn-secondary">Set filter</button></form>
<form class="card filterbar" method="post" action="/firm/directory-handle"><@ui.csrf/><div class="field grow"><label for="handle">Directory handle</label><input class="input" id="handle" name="handle" placeholder="a.rahman" required><span class="hint">Resolves your firm directory record from <a href="/firm/directory">the staff directory</a>.</span></div><button class="btn btn-secondary">Resolve</button></form>
<form class="card filterbar" method="get" action="/firm/register/view"><div class="field grow"><label for="caption">Register caption</label><input class="input" id="caption" name="caption" placeholder="Prepared for the weekly listing"></div><button class="btn btn-secondary">Open printable register</button></form>
<#if (query!'')?has_content>
<div class="grid grid-2">
<section class="card"><div class="card-head"><h2>Matters (${matters?size})</h2></div><div class="card-body"><#if matters?size==0><div class="empty"><strong>No matters found</strong>Try a broader case title or reference.</div><#else><#list matters as m><p><a class="record-link" href="/matters/${m.id}">${m.title}</a><br><span class="ref">${m.reference}</span> · <@ui.status m.status/></p></#list></#if></div></section>
<section class="card"><div class="card-head"><h2>Documents (${documents?size})</h2></div><div class="card-body"><#if documents?size==0><div class="empty"><strong>No documents found</strong>Only documents you may access are searched.</div><#else><#list documents as d><p><a class="record-link" href="/documents/${d.id}">${d.name}</a><br><span class="subtle">${d.category?replace('_',' ')?lower_case} · v${d.currentVersion}</span></p></#list></#if></div></section>
<section class="card"><div class="card-head"><h2>Tasks (${tasks?size})</h2></div><div class="card-body"><#if tasks?size==0><div class="empty"><strong>No tasks found</strong>Assigned and permitted tasks appear here.</div><#else><#list tasks as t><p><a class="record-link" href="/matters/${t.matterId}">${t.title}</a><br><@ui.status t.status/> · ${t.dueDate!'No due date'}</p></#list></#if></div></section>
<section class="card"><div class="card-head"><h2>Deadlines (${deadlines?size})</h2></div><div class="card-body"><#if deadlines?size==0><div class="empty"><strong>No deadlines found</strong>Try a filing or response title.</div><#else><#list deadlines as d><p><a class="record-link" href="/matters/${d.matterId}">${d.title}</a><br>${d.dueAt?keep_before('T')} · ${d.completed?then('completed','pending')}</p></#list></#if></div></section>
<#if currentUser.role!='CLIENT'><section class="card"><div class="card-head"><h2>Clients (${clients?size})</h2></div><div class="card-body"><#if clients?size==0><div class="empty"><strong>No clients found</strong>Search by name or email.</div><#else><#list clients as c><p><strong>${c.name}</strong><br><a href="mailto:${c.email}">${c.email}</a></p></#list></#if></div></section></#if>
</div>
</#if>
</@ui.page>
