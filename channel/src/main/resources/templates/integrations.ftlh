<#import "layout.ftlh" as ui>
<@ui.page title="Integrations" active="integrations">
<div class="page-head"><div><div class="eyebrow">Local integration controls</div><h1>API keys &amp; webhooks</h1><p class="lede">Credentials are hashed at rest and shown once. Webhook delivery is a localhost-only mock with recorded attempts.</p></div></div>
<div class="grid grid-2"><section class="card"><div class="card-head"><h2>API keys</h2></div><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Prefix</th><th>State</th><th>Created</th></tr></thead><tbody><#list apiKeys as key><tr><td><strong>${key.name}</strong></td><td><span class="ref">${key.prefix}…</span></td><td><@ui.status key.enabled?then('ACTIVE','DISABLED')/></td><td>${key.createdAt?keep_before('T')}</td></tr></#list></tbody></table></div><form class="card-body" method="post" action="/admin/integrations/api-keys"><@ui.csrf/><div class="field"><label for="key-name">Key name</label><input class="input" id="key-name" name="name" maxlength="100" required placeholder="Reporting connector"></div><button class="btn btn-primary">Create key</button></form></section>
<section class="card"><div class="card-head"><h2>Webhook delivery mock</h2></div><form class="card-body" method="post" action="/admin/integrations/webhooks/test"><@ui.csrf/><div class="field"><label for="targetUrl">Local target URL</label><input class="input" id="targetUrl" name="targetUrl" type="url" required value="http://localhost:9090/hooks/legal"><span class="hint">Only localhost targets are accepted; no external request is sent.</span></div><button class="btn btn-primary">Simulate delivery</button></form><form class="card-body" method="post" action="/admin/integrations/webhooks/deliver"><@ui.csrf/><div class="field"><label for="deliverUrl">Partner endpoint</label><input class="input" id="deliverUrl" name="targetUrl" type="url" required placeholder="https://partner.example/hooks/legal"></div><div class="field"><label for="eventType">Event</label><select class="select" id="eventType" name="eventType"><option>matter.updated</option><option>matter.closed</option><option>document.shared</option></select></div><button class="btn btn-secondary">Deliver to partner</button></form>
<div class="table-wrap"><table class="table"><thead><tr><th>Event</th><th>Target</th><th>Status</th></tr></thead><tbody><#list webhooks as hook><tr><td>${hook.eventType}</td><td><span class="ref">${hook.targetUrl}</span></td><td><@ui.status hook.status/></td></tr></#list></tbody></table></div></section></div>
</@ui.page>
